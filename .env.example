# Veltrix PeopleOps Assistant — every supported environment variable.
# Copy to .env and fill in ONE provider key. Never commit .env.

# --- Data paths ---------------------------------------------------------
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
# Where the vector index is stored (default: <DB_PATH folder>/vector_store)
VECTOR_STORE_PATH=

# --- Application --------------------------------------------------------
# "Today" for all date rules (YYYY-MM-DD). Empty = system date.
APP_TODAY=
# Year assumed for dates written without one (Section 8.4)
DEFAULT_YEAR=2026

# --- LLM provider -------------------------------------------------------
# openai | anthropic | google   (aliases: claude, gemini)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional OpenAI-compatible endpoint for LLM_PROVIDER=openai (empty = api.openai.com):
#   local Ollama : http://localhost:11434/v1   (OPENAI_API_KEY=ollama, LLM_MODEL=<pulled model>)
#                  from Docker use http://host.docker.internal:11434/v1
#   Groq         : https://api.groq.com/openai/v1
#   OpenRouter   : https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Optional JSON merged into OpenAI-compatible requests. For OpenRouter reasoning
# models (e.g. nvidia/nemotron-*) turn thinking off, or replies take 20-50 s:
#   OPENAI_EXTRA_BODY={"reasoning": {"enabled": false}}
OPENAI_EXTRA_BODY=
# Model name for the chosen provider. If left as gpt-4o-mini with another
# provider, a provider default is used (claude-3-5-haiku-latest / gemini-2.0-flash).
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# Per-attempt HTTP timeout and retries (each /chat request must finish in < 30 s)
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1
# Hard wall-clock limit per LLM call including retries; on overrun the answer
# falls back to quoting the retrieved passages
LLM_DEADLINE_SECONDS=18
# Sampling seed where supported (OpenAI)
LLM_SEED=7

# --- Embeddings ---------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional: Hugging Face cache folder (local runs; the Docker image has the model baked in)
HF_HOME=

# --- Retrieval ----------------------------------------------------------
# Hard cap on cl100k corpus tokens per LLM call (Section 4.3)
MAX_CORPUS_TOKENS=3000
RETRIEVAL_TOP_K=20
RETRIEVAL_FINAL_K=10
RETRIEVAL_MIN_SCORE=0.25
# Stricter relevance bar used only when no LLM key is configured
EXTRACTIVE_MIN_SCORE=0.43
MAX_CHUNKS_PER_DOC=3
UPCOMING_TOKEN_RESERVE=600

# --- API ----------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=27
MAX_MESSAGE_CHARS=4000
MAX_SESSION_ID_CHARS=200
# Comma-separated browser origins allowed by CORS (empty = CORS disabled)
CORS_ORIGINS=

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
